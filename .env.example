# Docker Compose demo configuration. Copy to .env before `docker compose up`.
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=outboundx
MYSQL_USER=outboundx
MYSQL_PASSWORD=outboundx

JWT_SECRET=local-development-secret-change-me-please
WEBHOOK_SECRET=local-webhook-secret-change-me
APP_ORIGIN=http://localhost:8080

API_PORT=4000
WEB_PORT=8080
